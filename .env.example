# Labo Photo Almas - Environment Configuration Template
# Duplicate this file as .env for local overrides (never commit production secrets)

# Server Port
PORT=3000

# Canonical Site URL
VITE_SITE_URL=https://labophotoalmas.ma

# WhatsApp Dispatch Number (International Format without '+')
VITE_WHATSAPP_PHONE=212522291649

# Production Security Mode (true | false)
VITE_ENABLE_SECURITY_SHIELD=true
